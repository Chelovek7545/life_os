{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "life_os",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/lib/main.dart",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "life_os (Windows)",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/lib/main.dart",
            "request": "launch",
            "type": "dart",
            "deviceId": "windows"
        },
        {
            "name": "life_os (profile mode)",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/lib/main.dart",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "life_os (release mode)",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/lib/main.dart",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}
